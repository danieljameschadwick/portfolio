generator client {
  provider      = "prisma-client-js"
  output        = "app/generated/prisma/client"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mongodb"
  url      = env("ORM_CLIENT_URL")
}

model Card {
  id           String   @id @map("_id")
  title        String
  cardType     String
  description  String
  displayOrder Int
  subTitle     String?
  imagePath    String?
  technologies String[]
  links        Link[]
}

type Link {
  type String
  text String
  href String
}
